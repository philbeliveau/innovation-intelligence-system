# Innovation Intelligence System - Environment Variables Template
# Copy this file to .env and fill in your actual values

# OpenRouter API Configuration
# Get your API key from: https://openrouter.ai/keys
# OpenRouter API Base URL
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# LLM Model Configuration
# ⚡ CHANGE THIS ONE VALUE TO SWITCH MODELS ACROSS ENTIRE PIPELINE ⚡
# Popular options:
# - openai/gpt-4o-mini (GPT-4o Mini - DEFAULT, reliable rate limits)
# - deepseek/deepseek-chat (DeepSeek V3.2 Exp - may have rate limits)
# - anthropic/claude-3.5-sonnet (Claude Sonnet 3.5)
# - anthropic/claude-sonnet-4.5-20250514 (Claude Sonnet 4.5)
# - openai/gpt-4-turbo (GPT-4 Turbo)
# See https://openrouter.ai/models for full list
LLM_MODEL=openai/gpt-4o-mini
